<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Glacier Red Meadow Loop" xmlns="http://www.topografix.com/GPX/1/1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd">
  <metadata>
    <name>Red Meadow Loop — Glacier NP Bikepacking</name>
    <desc>~116 mi self-supported gravel loop from Whitefish over Red Meadow Pass through Glacier NP. Route, campsites (main + backup), and points of interest.</desc>
  </metadata>
  <wpt lat="48.4111" lon="-114.3376">
    <name>Start / Finish — Whitefish</name>
    <desc>Whitefish, MT. Loop start and finish. Bike pickup at Glacier Cyclery (326 2nd St E).</desc>
    <type>Trailhead</type>
  </wpt>
  <wpt lat="48.68669" lon="-114.57889">
    <name>Upper Whitefish Lake</name>
    <desc>Night 1 target. Flathead NF campground, water, swim. ~4,400 ft, ~20-25 mi in. Banks a chunk of Saturday's climb.</desc>
    <type>Camp</type>
  </wpt>
  <wpt lat="48.62" lon="-114.55">
    <name>Night 1 — dispersed fallback</name>
    <desc>Standard fallback camp: first legal dispersed pullout on NF land with creek/river water, as high as the light allows.</desc>
    <type>Camp</type>
  </wpt>
  <wpt lat="48.7772" lon="-114.3029">
    <name>Red Meadow Pass — 5,600 ft</name>
    <desc>High point of the loop. Long descent to the North Fork after this.</desc>
    <type>Summit</type>
  </wpt>
  <wpt lat="48.76194" lon="-114.28361">
    <name>Polebridge Mercantile</name>
    <desc>Day 2 resupply. Famous bear claws + small store. Only resupply on route. Cash-friendly, hours vary.</desc>
    <type>Resupply</type>
  </wpt>
  <wpt lat="48.8275" lon="-114.2017">
    <name>Night 2 — Bowman Lake</name>
    <desc>Camp Night 2, inside Glacier NP. First-come.</desc>
    <type>Camp</type>
  </wpt>
  <wpt lat="48.4956" lon="-113.9869">
    <name>Night 3 — West Glacier</name>
    <desc>Camp Night 3, West Glacier area (outside park).</desc>
    <type>Camp</type>
  </wpt>
  <wpt lat="48.6066" lon="-113.879">
    <name>Backup N3 — Sprague Creek</name>
    <desc>Backup Night 3: Sprague Creek hiker/biker site (inside Glacier NP).</desc>
    <type>Camp</type>
  </wpt>
  <wpt lat="48.5258" lon="-113.992">
    <name>Backup N3 — Apgar</name>
    <desc>Backup Night 3: Apgar hiker/biker site (inside Glacier NP).</desc>
    <type>Camp</type>
  </wpt>
  <wpt lat="48.4656" lon="-114.0735">
    <name>Backup N3 — Blankenship</name>
    <desc>Backup Night 3: Blankenship Bridge area (outside park).</desc>
    <type>Camp</type>
  </wpt>
  <trk>
    <name>Red Meadow Loop</name>
