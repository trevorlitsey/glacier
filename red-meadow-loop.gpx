<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Glacier Red Meadow Loop (fork of RideWithGPS 15106314)" xmlns="http://www.topografix.com/GPX/1/1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd">
  <metadata>
    <name>Red Meadow Loop - Glacier NP Bikepacking</name>
    <desc>~105 mi self-supported gravel loop from Whitefish over Red Meadow Pass through Glacier NP. Full survey route with campsites (main + backup) and points of interest. Track forked from the Bikepacking.com / RideWithGPS Red Meadow Pass Loop (https://ridewithgps.com/routes/15106314). Waypoints (camps, resupply, POIs) added for this trip. Bowman Lake (Night 2) is a ~6 mi signed spur off the North Fork Rd at Polebridge — not on the mainline track.</desc>
    <link href="https://ridewithgps.com/routes/15106314"><text>Source route: Red Meadow Pass Loop (RideWithGPS)</text></link>
  </metadata>
  <wpt lat="48.4111" lon="-114.3376">
    <name>Start / Finish - Whitefish</name>
    <desc>Whitefish, MT. Loop start and finish. Bike pickup at Glacier Cyclery (326 2nd St E).</desc>
    <type>Trailhead</type>
  </wpt>
  <wpt lat="48.68558" lon="-114.5753">
    <name>Upper Whitefish Lake</name>
    <desc>Night 1 target. Flathead NF campground, water, swim. ~4,400 ft. Banks a chunk of Saturday's climb.</desc>
    <type>Camp</type>
  </wpt>
  <wpt lat="48.62" lon="-114.55">
    <name>Night 1 - dispersed fallback</name>
    <desc>Fallback camp: first legal dispersed pullout on NF land with creek/river water, as high as light allows.</desc>
    <type>Camp</type>
  </wpt>
  <wpt lat="48.75384" lon="-114.56335">
    <name>Red Meadow Lake</name>
    <desc>Alpine lake just below Red Meadow Pass. Classic swim / water stop.</desc>
    <type>Waypoint</type>
  </wpt>
  <wpt lat="48.7772" lon="-114.3029">
    <name>Red Meadow Pass - 5,600 ft</name>
    <desc>High point of the loop. Long descent to the North Fork after this.</desc>
    <type>Summit</type>
  </wpt>
  <wpt lat="48.76496" lon="-114.28478">
    <name>Polebridge Mercantile</name>
    <desc>Resupply + famous bear claws. Only resupply on route. Bowman Lake spur turns off the North Fork Rd here.</desc>
    <type>Resupply</type>
  </wpt>
  <wpt lat="48.8275" lon="-114.2017">
    <name>Night 2 - Bowman Lake</name>
    <desc>Night 2 camp, Glacier NP. ~6 mi signed spur EAST off the North Fork Rd near Polebridge - NOT on the mainline track. First-come.</desc>
    <type>Camp</type>
  </wpt>
  <wpt lat="48.4956" lon="-113.9869">
    <name>Night 3 - West Glacier</name>
    <desc>Night 3 camp, West Glacier area (outside park).</desc>
    <type>Camp</type>
  </wpt>
  <wpt lat="48.6066" lon="-113.879">
    <name>Backup N3 - Sprague Creek</name>
    <desc>Backup Night 3: Sprague Creek hiker/biker site (Glacier NP).</desc>
    <type>Camp</type>
  </wpt>
  <wpt lat="48.5258" lon="-113.992">
    <name>Backup N3 - Apgar</name>
    <desc>Backup Night 3: Apgar hiker/biker site (Glacier NP).</desc>
    <type>Camp</type>
  </wpt>
  <wpt lat="48.4656" lon="-114.0735">
    <name>Backup N3 - Blankenship</name>
    <desc>Backup Night 3: Blankenship Bridge area (outside park).</desc>
    <type>Camp</type>
  </wpt>
  <trk>
    <name>Red Meadow Loop - Glacier NP Bikepacking</name>
